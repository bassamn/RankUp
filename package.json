{
  "name": "rankup",
  "version": "1.0.0",
  "description": "A focused desktop time tracker and productivity dashboard.",
  "desktopName": "RankUp",
  "main": "src/main/main.cjs",
  "author": {
    "name": "RankUp",
    "email": "support@rankup.app"
  },
  "homepage": "https://rankup.app",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && node scripts/build-current.cjs",
    "dist:win": "npm run build && npm run build:win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "ensure:win-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-code-signing-cert.ps1",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -AllPlatforms"
  },
  "dependencies": {
    "chart.js": "^4.4.9",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.rankup.desktop",
    "productName": "RankUp",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/db/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "certificateFile": "build/certs/rankup-local-code-signing.pfx"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "rankup",
      "synopsis": "Focus timer and productivity dashboard",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
